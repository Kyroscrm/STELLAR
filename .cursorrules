// Multi-Layer Caching for CRM Data
const useCacheStrategy = () => {
  const cache = {
    // L1: Component-level cache (React state)
    component: new Map<string, any>(),

    // L2: Session cache (sessionStorage equivalent)
    session: new Map<string, any>(),

    // L3: Database cache (Supabase with TTL)
    database: new Map<string, { data: any; expires: number }>(),
